# ══════════════════════════════════════════════════════════════════════
# MACRO DATA UPDATER - CONFIGURATION
# ══════════════════════════════════════════════════════════════════════
# Copy this file and fill in your settings.
# Get a free FRED API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# ══════════════════════════════════════════════════════════════════════

# REQUIRED: Your FRED API key (free, register at link above)
FRED_API_KEY=your_fred_api_key_here

# OPTIONAL: Cache duration in hours (default: 1)
# Prevents re-fetching the same data within this window
CACHE_TTL_HOURS=1

# OPTIONAL: Path to the Excel workbook (default: auto-detect in script dir)
# WORKBOOK_PATH=Macro_Monitoring_Workbook.xlsx

# OPTIONAL: Path to HTML dashboard (default: auto-detect in script dir)
# DASHBOARD_PATH=macro_dashboard.html
